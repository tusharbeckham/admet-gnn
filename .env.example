# =============================================================================
#  ADMETriage -- environment template
#
#  Manual Listing 4.4.
#
#      cp .env.example .env        then edit .env
#
#  `.env` is gitignored. THIS file is committed, so it must never contain a real
#  credential -- every value below is a placeholder or a local-only default.
#
#  Layering: these variables are the HIGHEST-precedence configuration source.
#  They override config/default.toml and config/{profile}.toml. The nesting
#  separator is a DOUBLE underscore:
#
#      ADMET_SERVER__PORT=9000        ->  [server] port
#      ADMET_DATABASE__URL=...        ->  [database] url
#
#  A single underscore does not work and fails as a "missing field" error at
#  start-up, which is the confusing five minutes this comment exists to prevent.
#
#  Nothing loads `.env` automatically. Either export it in your shell
#  (`set -a; source .env; set +a`) or let docker compose read it -- there is no
#  dotenv crate in the dependency tree, on purpose, because a config source that
#  works locally and silently does nothing in production is worse than no config
#  source.
# =============================================================================

# --- profile -----------------------------------------------------------------
# Selects the optional config/{profile}.toml overlay. local | docker | ci.
ADMET_PROFILE=local

# --- database ----------------------------------------------------------------
# Matches `just db-up`. Port 5433, not 5432, so it cannot collide with a
# Postgres already installed on the machine.
#
# CHANGE THE PASSWORD if this database is reachable by anything but you.
ADMET_DATABASE__URL=postgres://admet:changeme@localhost:5433/admet
ADMET_DATABASE__MAX_CONNECTIONS=10
ADMET_DATABASE__MIGRATE_ON_START=true

# sqlx-cli reads DATABASE_URL specifically, not the ADMET_ prefixed name, so it
# is duplicated here rather than being redundant.
DATABASE_URL=postgres://admet:changeme@localhost:5433/admet

# --- server ------------------------------------------------------------------
ADMET_SERVER__HOST=127.0.0.1
ADMET_SERVER__PORT=8080

# DO NOT set HOST=0.0.0.0 before Increment 3.
#
# There is no authentication on any route until FR-23 lands (UC-07, Increment 3).
# On 0.0.0.0 the
# service is reachable from every device on your network, and /predict will
# happily run inference for any of them. Loopback is the only access control
# that currently exists.

# Comma-separated. Explicit origins, never "*" -- a wildcard cannot be combined
# with the session cookie Increment 3 introduces.
ADMET_SERVER__CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- model -------------------------------------------------------------------
ADMET_MODEL__PATH=models/model.onnx
ADMET_MODEL__INTRA_THREADS=1
ADMET_MODEL__MAX_BATCH=64

# --- logging -----------------------------------------------------------------
# `tower_http=debug` is what emits one line per request with method, path,
# status and duration. That line is the NFR-01 latency evidence until there is a
# metrics endpoint to ask instead, so do not quieten it in development.
RUST_LOG=info,admet_api=debug,admet_db=info,tower_http=debug

# `json` for a log aggregator, anything else for aligned human columns.
ADMET_LOG_FORMAT=pretty

# Full backtraces on panic. Costs nothing until something panics.
RUST_BACKTRACE=1

# --- build metadata ----------------------------------------------------------
# Baked into /version by option_env! at compile time. CI sets this; locally it
# reports "unknown", which is correct rather than wrong.
# ADMET_GIT_COMMIT=

# --- frontend (Increment 3) --------------------------------------------------
# Vite exposes only VITE_-prefixed variables to browser code. Anything secret
# must NOT carry this prefix -- it ends up in the shipped bundle.
VITE_API_BASE_URL=http://localhost:8080
